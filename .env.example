# =============================================================
# 环境变量示例 — 复制为 .env 后填写
#   cp .env.example .env
#
# 两种部署方式都读取本文件:
#   - 非 Docker (PM2): 服务器运行时从 .env 读取
#   - Docker: compose 用 .env 替换 ${VAR} 并作为构建参数
# =============================================================

# ========== 数据库 ==========
# 主机名取决于部署方式，抄错会报 P1001 Can't reach database server：
#   - 非 Docker (PM2，主机直装 PostgreSQL)：localhost   ← 默认值，按原样用
#   - Docker (compose)：db（compose 服务名）
#     走 Docker 时**无需修改本行**：docker-compose.yml 会在容器内
#     用 POSTGRES_USER/PASSWORD/DB 重新拼装连接串并强制主机名为 db。
DATABASE_URL="postgresql://b2b_user:b2b_password@localhost:5432/b2b_independent_site?schema=public"
POSTGRES_USER="b2b_user"
POSTGRES_PASSWORD="b2b_password"
POSTGRES_DB="b2b_independent_site"

# ========== NextAuth 认证 ==========
# 生成: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-random-secret"
NEXTAUTH_URL="https://commoditychina.com"

# Google OAuth (可选)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple OAuth (可选)
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# ========== Stripe 支付 (暂未启用，可留空) ==========
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ========== PayPal 支付 ==========
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_API_URL="https://api-m.paypal.com"

# ========== OpenAI ==========
OPENAI_API_KEY=""

# ========== Gmail SMTP (需要应用专用密码) ==========
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Commodities From China <no-reply@commoditychina.com>"

# ========== 站点配置 (构建期变量, 改后需重新构建) ==========
NEXT_PUBLIC_SITE_URL="https://commoditychina.com"
NEXT_PUBLIC_SITE_NAME="Commodities From China"

# ========== 广告/分析 (可选) ==========
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=""
NEXT_PUBLIC_GOOGLE_ADS_ID=""
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_VERIFICATION=""
NEXT_PUBLIC_TWITTER_HANDLE="@commoditychina"

# ========== 邮件备份 (Resend, 可选) ==========
RESEND_API_KEY=""

# ========== 物流追踪 17Track (可选) ==========
NEXT_PUBLIC_17TRACK_API_KEY=""

# ========== 文件上传 (可选) ==========
# 上传文件目录（产品图等）。务必设在 .next/ 之外的可持久化位置，
# 否则每次 next build 重写 .next/standalone 会清空已上传图片（重新部署后图片显示不了）。
#   - Docker: 必须指向挂载卷, 否则容器重建后上传文件丢失:  UPLOAD_DIR="/app/public/uploads"
#   - PM2: ecosystem.config.js 已默认指向项目根目录 uploads/, 无需手动设置
UPLOAD_DIR=""
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""