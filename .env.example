# =============================================================
# 环境变量示例 — 复制为 .env 后填写
#   cp .env.example .env
#
# 部署方式：系统 Node + PM2 + 系统 Nginx + PostgreSQL（不使用 Docker）
# 运行时由 Node 进程直接读取本文件。
# =============================================================

# ========== 数据库 ==========
# 主机名固定 localhost（PostgreSQL 直装在宿主机上）。
# 误填容器服务名 db 会报：P1001 Can't reach database server at `db:5432`
DATABASE_URL="postgresql://b2b_user:b2b_password@localhost:5432/b2b_independent_site?schema=public"
POSTGRES_USER="b2b_user"
POSTGRES_PASSWORD="b2b_password"
POSTGRES_DB="b2b_independent_site"

# ========== NextAuth 认证 ==========
# 生成: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-random-secret"
NEXTAUTH_URL="https://commoditychina.com"

# Google OAuth (可选)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple OAuth (可选)
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# ========== Stripe 支付 (暂未启用，可留空) ==========
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ========== PayPal 支付 ==========
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_API_URL="https://api-m.paypal.com"

# ========== OpenAI ==========
OPENAI_API_KEY=""

# ========== Gmail SMTP (需要应用专用密码) ==========
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Commodities From China <no-reply@commoditychina.com>"

# ========== 站点配置 (构建期变量, 改后需重新构建) ==========
NEXT_PUBLIC_SITE_URL="https://commoditychina.com"
NEXT_PUBLIC_SITE_NAME="Commodities From China"

# ========== 广告/分析 (可选) ==========
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=""
NEXT_PUBLIC_GOOGLE_ADS_ID=""
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_VERIFICATION=""
NEXT_PUBLIC_TWITTER_HANDLE="@commoditychina"

# ========== 邮件备份 (Resend, 可选) ==========
RESEND_API_KEY=""

# ========== 物流追踪 17Track (可选) ==========
NEXT_PUBLIC_17TRACK_API_KEY=""

# ========== 文件上传 (可选) ==========
# 上传文件目录（产品图等）。务必设在 .next/ 之外的可持久化位置，
# 否则每次 next build 重写 .next/standalone 会清空已上传图片（重新部署后图片显示不了）。
#   - PM2: ecosystem.config.js 已默认指向项目根目录 uploads/, 无需手动设置
UPLOAD_DIR=""
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# ========== 报价单 PDF 字体（强烈建议配置） ==========
# 未配置时 PDF 会退回内置 Helvetica，只能编码 WinAnsi 字符：
# 中文、阿拉伯文、西里尔文等会被替换成 "?"，买家姓名会显示错误。
# 请指向单个 .ttf 或 .otf 字体文件。字体集合（.ttc / .otc）不受支持，
# PDFKit 无法对其做子集化，配置后会在生成 PDF 时直接报错。
# 也可以把文件命名为 public/fonts/quotation-regular.ttf（及 -bold.ttf）。
QUOTATION_PDF_FONT=""
QUOTATION_PDF_FONT_BOLD=""
