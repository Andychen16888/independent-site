{
  "name": "b2b-independent-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && node scripts/copy-standalone-static.js",
    "build:server": "prisma generate && NODE_OPTIONS=\"--max-old-space-size=4096\" next build && node scripts/copy-standalone-static.js",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "node scripts/require-db-env.mjs && prisma db push",
    "db:seed": "prisma generate && node scripts/require-db-env.mjs && prisma db seed",
    "db:migrate": "node scripts/require-db-env.mjs && prisma migrate deploy",
    "db:check-analytics": "node scripts/require-db-env.mjs && tsx scripts/check-analytics-schema.ts",
    "db:diagnose-trails": "node scripts/require-db-env.mjs && tsx scripts/diagnose-trails.ts",
    "test:tracking": "tsx scripts/test-tracking.ts",
    "db:translate-blog": "tsx prisma/translate-blog-content.ts",
    "db:translate-products": "tsx prisma/translate-product-content.ts",
    "db:fix-product-slugs": "tsx scripts/fix-product-slugs.ts",
    "db:fix-category-slugs": "tsx scripts/fix-category-slugs.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@hookform/resolvers": "^5.2.2",
    "@paypal/react-paypal-js": "^8.9.2",
    "@prisma/client": "^6.19.3",
    "@stripe/react-stripe-js": "^6.3.0",
    "@stripe/stripe-js": "^6.1.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tiptap/extension-font-family": "^3.26.0",
    "@tiptap/extension-placeholder": "^3.26.0",
    "@tiptap/extension-text-style": "^3.26.0",
    "@tiptap/extension-underline": "^3.26.0",
    "@tiptap/pm": "^3.26.0",
    "@tiptap/react": "^3.26.0",
    "@tiptap/starter-kit": "^3.26.0",
    "ai": "^6.0.182",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.4",
    "fontkit": "^2.0.4",
    "framer-motion": "^12.6.3",
    "geoip-lite": "^1.4.10",
    "isomorphic-dompurify": "^2.2.0",
    "marked": "^15.0.7",
    "next": "15.2.4",
    "next-auth": "^4.24.11",
    "next-intl": "^4.14.5",
    "nodemailer": "^8.0.10",
    "openai": "^6.37.0",
    "pdfkit": "^0.20.2",
    "prisma": "^6.19.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-hot-toast": "^2.5.2",
    "react-icons": "^5.4.0",
    "react-multi-carousel": "^2.8.5",
    "resend": "^4.2.0",
    "sharp": "^0.34.1",
    "slugify": "^1.6.6",
    "stripe": "^18.0.0",
    "swiper": "^11.2.6",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4",
    "uuid": "^11.1.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/bcryptjs": "^2.4.6",
    "@types/dompurify": "^3.2.0",
    "@types/fontkit": "^2.0.9",
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^20.19.41",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.2.4",
    "tsx": "^4.19.3",
    "typescript": "^5"
  }
}
