generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum UserRole {
  USER
  ADMIN
  AFFILIATE
  MODERATOR
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum CouponType {
  PUBLIC
  PRIVATE
  WELCOME
  REFERRAL
  ABANDONED_CART
}

enum AffiliateStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum Currency {
  USD
  EUR
  GBP
  CAD
  AUD
  /// The invoicing currency of the seller's own base.
  CNY
  JPY
  SGD
  AED
  INR
  CHF
  HKD
  KRW
  MXN
  THB
  VND
  IDR
  MYR
  PHP
  NZD
  SEK
  NOK
  DKK
  PLN
  TRY
  BRL
  ZAR
  RUB
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  resetToken    String?   @unique
  resetTokenExpires DateTime?
  firstName     String?
  lastName      String?
  phone         String?
  avatar        String?
  role          UserRole  @default(USER)
  points        Int       @default(0)
  tier          String    @default("BRONZE")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  addresses       Address[]
  orders          Order[]
  reviews         Review[]
  wishlist        WishlistItem[]
  affiliate       Affiliate?
  referrals       AffiliateReferral[]  @relation("ReferredUser")
    usedCoupons     UsedCoupon[]
    cart            Cart?
    blogComments    BlogComment[]
    assignedInquiries Inquiry[] @relation("InquiryAssignee")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Category {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String?  @db.Text
  image          String?
  parentId       String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  isFeatured     Boolean  @default(false)
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent       Category?   @relation("CategoryParent", fields: [parentId], references: [id])
  children     Category[]  @relation("CategoryParent")
  products     ProductCategory[]
  banner       CategoryBanner?
  translations CategoryTranslation[]

  @@map("categories")
}

model CategoryTranslation {
  id         String   @id @default(cuid())
  categoryId String
  locale     String
  name       String

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([locale])
  @@map("category_translations")
}

model CategoryBanner {
  id         String   @id @default(cuid())
  categoryId String   @unique
  image      String
  title      String?
  subtitle   String?
  createdAt  DateTime @default(now())

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("category_banners")
}

model Product {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique
  sku             String        @unique
  brand           String?
  model           String?
  tags            String?
  description     String        @db.Text
  shortDescription String?
  unitPrice       Decimal?      @db.Decimal(10, 2)
  originalPrice   Decimal?      @db.Decimal(10, 2)
  costPrice       Decimal?      @db.Decimal(10, 2)
  currency        Currency      @default(USD)
  stock           Int           @default(0)
  status          ProductStatus @default(ACTIVE)
  weight          Decimal?      @db.Decimal(8, 2)
  isFeatured      Boolean       @default(false)
  isBestSeller    Boolean       @default(false)
  isNew           Boolean       @default(false)
  isHomeFeatured  Boolean       @default(false)
  sortOrder       Int           @default(0)
  deletedAt       DateTime?
  seoTitle        String?
  seoDescription  String?
  seoKeywords     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  categories      ProductCategory[]
  images          ProductImage[]
  videos          ProductVideo[]
  parameters      ProductParameter[]
  reviews         Review[]
  orderItems      OrderItem[]
  wishlistItems   WishlistItem[]
  cartItems       CartItem[]
  faqs            ProductFAQ[]
  relatedProducts ProductRelation[]        @relation("ProductRelationSource")
  relatedFrom     ProductRelation[]        @relation("ProductRelationTarget")
  translations    ProductTranslation[]
  inquiries       Inquiry[]

  @@index([slug])
  @@index([sku])
  @@index([status])
  @@index([deletedAt])
  @@index([isFeatured])
  @@index([isBestSeller])
  @@map("products")
}

model ProductCategory {
  productId  String
  categoryId String
  sortOrder  Int @default(0)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductVideo {
  id        String @id @default(cuid())
  productId String
  url       String
  title     String?
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_videos")
}

model ProductParameter {
  id        String @id @default(cuid())
  productId String
  name      String
  value     String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_parameters")
}

model ProductFAQ {
  id        String   @id @default(cuid())
  productId String
  question  String
  answer    String   @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_faqs")
}

model ProductRelation {
  id              String @id @default(cuid())
  sourceProductId String
  targetProductId String
  type            String @default("RELATED")

  source Product @relation("ProductRelationSource", fields: [sourceProductId], references: [id], onDelete: Cascade)
  target Product @relation("ProductRelationTarget", fields: [targetProductId], references: [id], onDelete: Cascade)

  @@unique([sourceProductId, targetProductId])
  @@map("product_relations")
}

model ProductTranslation {
  id              String   @id @default(cuid())
  productId       String
  locale          String
  name            String
  shortDescription String?
  description     String?
  seoTitle        String?
  seoDescription  String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([locale])
  @@map("product_translations")
}

model Address {
  id        String   @id @default(cuid())
  userId     String?
  firstName  String
  lastName   String
  phone      String?
  street     String
  street2    String?
  city       String
  state      String?
  zipCode    String
  country    String  @default("US")
  isDefault  Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user           User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders         Order[] @relation("ShippingAddress")
  billingOrders  Order[] @relation("BillingAddress")

  @@map("addresses")
}

model Order {
  id              String       @id @default(cuid())
  orderNumber     String       @unique
  userId          String?
  email           String
  status          OrderStatus  @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  subtotal        Decimal      @db.Decimal(10, 2)
  shippingCost    Decimal      @db.Decimal(10, 2) @default(0)
  taxAmount       Decimal      @db.Decimal(10, 2) @default(0)
  discountAmount  Decimal      @db.Decimal(10, 2) @default(0)
  total           Decimal      @db.Decimal(10, 2)
  currency        Currency     @default(USD)
  shippingAddressId String?
  billingAddressId  String?
  couponId        String?
  trackingNumber  String?
  trackingProvider String?
  shippingMethod  String?
  notes           String?      @db.Text
  paidAt          DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user        User?         @relation(fields: [userId], references: [id])
  shippingAddress Address?  @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddress  Address?  @relation("BillingAddress", fields: [billingAddressId], references: [id])
  coupon      Coupon?       @relation(fields: [couponId], references: [id])
  items       OrderItem[]
  payments    Payment[]
  tracking    TrackingEvent[]
  affiliateReferrals AffiliateReferral[]

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  productId      String?
  productName    String
  productSku     String?
  unitPrice      Decimal  @db.Decimal(10, 2)
  quantity       Int      @default(1)
  totalPrice     Decimal  @db.Decimal(10, 2)
  productImage   String?
  createdAt      DateTime @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String
  method          String
  transactionId   String?
  amount          Decimal       @db.Decimal(10, 2)
  currency        Currency      @default(USD)
  status          PaymentStatus @default(PENDING)
  responseData    Json?
  createdAt       DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model TrackingEvent {
  id        String   @id @default(cuid())
  orderId   String
  location  String?
  status    String?
  message   String?
  timestamp DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("tracking_events")
}

model Cart {
  id        String      @id @default(cuid())
  userId    String?     @unique
  sessionId String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user    User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items   CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  orderId   String?
  rating    Int
  title     String?
  content   String   @db.Text
  isVerified Boolean @default(false)
  isApproved Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  images  ReviewImage[]
  votes   ReviewVote[]

  @@unique([productId, userId, orderId])
  @@map("reviews")
}

model ReviewImage {
  id       String @id @default(cuid())
  reviewId String
  url      String
  type     String @default("IMAGE")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_images")
}

model ReviewVote {
  id       String @id @default(cuid())
  reviewId String
  userId   String
  helpful  Boolean @default(true)

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@map("review_votes")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  type          CouponType   @default(PUBLIC)
  discountType  DiscountType @default(PERCENTAGE)
  discountValue Decimal      @db.Decimal(10, 2)
  minOrderAmount Decimal?    @db.Decimal(10, 2)
  maxDiscount   Decimal?     @db.Decimal(10, 2)
  maxUses       Int?
  usedCount     Int          @default(0)
  maxUsesPerUser Int?
  isActive      Boolean      @default(true)
  startsAt      DateTime?
  expiresAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  orders     Order[]
  usedBy     UsedCoupon[]

  @@index([code])
  @@map("coupons")
}

model UsedCoupon {
  id       String @id @default(cuid())
  couponId String
  userId   String
  usedAt   DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@map("used_coupons")
}

model Affiliate {
  id            String         @id @default(cuid())
  userId        String         @unique
  code          String         @unique
  status        AffiliateStatus @default(PENDING)
  commissionRate Decimal        @db.Decimal(5, 2) @default(5.00)
  totalEarned   Decimal         @db.Decimal(10, 2) @default(0)
  totalWithdrawn Decimal        @db.Decimal(10, 2) @default(0)
  paypalEmail   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals AffiliateReferral[] @relation("AffiliateRef")

  @@map("affiliates")
}

model AffiliateReferral {
  id          String   @id @default(cuid())
  affiliateId String
  referredUserId String?
  orderId     String?
  commission  Decimal? @db.Decimal(10, 2)
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  affiliate    Affiliate @relation("AffiliateRef", fields: [affiliateId], references: [id], onDelete: Cascade)
  referredUser User?     @relation("ReferredUser", fields: [referredUserId], references: [id])
  order        Order?    @relation(fields: [orderId], references: [id])

  @@map("affiliate_referrals")
}

model BlogPost {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  excerpt       String?  @db.Text
  content       String   @db.Text
  coverImage    String?
  author        String   @default("Admin")
  tags          String?
  isPublished   Boolean  @default(false)
  publishedAt   DateTime?
  seoTitle      String?
  seoDescription String?
  seoKeywords   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  comments    BlogComment[]
  translations BlogPostTranslation[]

  @@index([slug])
  @@index([isPublished])
  @@index([publishedAt])
  @@map("blog_posts")
}

model BlogPostTranslation {
  id              String   @id @default(cuid())
  blogPostId      String
  locale          String
  title           String
  excerpt         String?  @db.Text
  content         String?  @db.Text
  seoTitle        String?
  seoDescription  String?
  seoKeywords     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  blogPost BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@unique([blogPostId, locale])
  @@index([locale])
  @@map("blog_post_translations")
}

model BlogComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String   @db.Text
  isApproved Boolean @default(false)
  createdAt DateTime @default(now())

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("blog_comments")
}

model Newsletter {
  id               String   @id @default(cuid())
  email            String   @unique
  isActive         Boolean  @default(true)
  unsubscribeToken String?  @unique
  createdAt        DateTime @default(now())

  @@map("newsletters")
}

enum NewsletterCampaignStatus {
  SENDING
  /// Hit its daily quota. Picks itself back up at `nextRunAt`.
  PAUSED
  COMPLETED
  STOPPED
  FAILED
}

enum NewsletterSendStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// One bulk send. The recipient list is snapshotted into NewsletterSend rows at
/// creation so the run has a fixed audience and a durable per-recipient log.
model NewsletterCampaign {
  id            String                    @id @default(cuid())
  subject       String
  body          String
  status        NewsletterCampaignStatus  @default(SENDING)
  /// Pause between deliveries. Bulk mail sent back-to-back is what triggers
  /// provider throttling, so this is a first-class knob rather than a constant.
  delayMs       Int                       @default(2000)
  /// Ceiling on deliveries per calendar day. 0 means send the whole audience in
  /// one run; anything above 0 spreads the campaign over as many days as it
  /// takes, which is the safer shape once a list gets large.
  dailyQuota    Int                       @default(0)
  /// When a PAUSED campaign becomes eligible again. Null unless paused.
  nextRunAt     DateTime?
  totalCount    Int                       @default(0)
  sentCount     Int                       @default(0)
  failedCount   Int                       @default(0)
  /// Cooperative stop flag: the runner checks it before each delivery.
  stopRequested Boolean                   @default(false)
  error         String?
  startedAt     DateTime                  @default(now())
  completedAt   DateTime?
  createdAt     DateTime                  @default(now())

  recipients NewsletterSend[]

  @@index([status])
  @@index([createdAt])
  @@index([status, nextRunAt])
  @@map("newsletter_campaigns")
}

model NewsletterSend {
  id         String               @id @default(cuid())
  campaignId String
  campaign   NewsletterCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email      String
  status     NewsletterSendStatus @default(PENDING)
  error      String?
  sentAt     DateTime?
  createdAt  DateTime             @default(now())

  @@index([campaignId])
  @@index([campaignId, status])
  @@map("newsletter_sends")
}

/// Reusable subject/body pair so recurring mail does not get retyped.
model NewsletterTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  subject   String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("newsletter_templates")
}

enum InquiryStatus {
  NEW
  PROCESSING
  QUOTATION_SENT
  CUSTOMER_REPLIED
  NEGOTIATION
  ORDER_CONFIRMED
  LOST
}

enum InquirySource {
  WEBSITE_RFQ
  PRODUCT_PAGE
  CAMPAIGN
  AI_AGENT
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  REJECTED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

/// OUTBOUND goes to the customer, INTERNAL is a staff notification. Kept
/// separate so the customer-facing thread stays readable.
enum EmailDirection {
  OUTBOUND
  INTERNAL
}

enum EmailPurpose {
  QUOTATION
  FOLLOW_UP
  GENERAL
  NOTIFICATION
}

enum FollowUpStatus {
  PENDING
  DONE
  CANCELLED
}

/// Daily counter behind the human-readable RFQ / QT document numbers.
/// A row per scope and day, incremented atomically, so two concurrent
/// submissions can never be handed the same number.
model NumberSequence {
  id        String @id @default(cuid())
  /// "RFQ" for inquiries, "QT" for quotations, "EM" for email records.
  scope     String
  /// yyyyMMdd
  periodDay String
  counter   Int    @default(0)

  @@unique([scope, periodDay])
  @@map("number_sequences")
}

/// A sales enquiry from a prospective buyer.
///
/// The product fields are a deliberate snapshot taken at submission time rather
/// than a live join: an enquiry is a record of what was asked for on that date,
/// and must not change when the product is later renamed, re-priced or deleted.
model Inquiry {
  id           String        @id @default(cuid())
  inquiryNo    String        @unique
  customerName String
  companyName  String?
  country      String?
  city         String?
  address      String?       @db.Text
  email        String
  whatsapp     String?
  phone        String?
  website      String?
  jobTitle     String?
  linkedin     String?

  source InquirySource @default(WEBSITE_RFQ)
  locale String?

  productId        String?
  product          Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName      String?
  productImage     String?
  productCategory  String?
  modelNumber      String?
  /// Decimal, not Int: steel is quoted in fractional tons (12.5 t) and in
  /// millimetres, and a whole-number column would force the sales team to round
  /// a buyer's stated requirement.
  quantity         Decimal?   @db.Decimal(20, 3)
  unit             String?
  targetPrice      Decimal?   @db.Decimal(12, 2)
  currency         Currency   @default(USD)
  application      String?    @db.Text
  customerMessage  String?    @db.Text

  status          InquiryStatus @default(NEW)
  assignedUserId  String?
  assignedUser    User?         @relation("InquiryAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  lostReason      String?
  internalNote    String?       @db.Text

  /// Reserved for the AI assistant: intent read off the message, a suggested
  /// price, and a drafted reply. Stored as text so the raw model output stays
  /// available for review instead of being applied automatically.
  customerIntent   String?  @db.Text
  recommendedPrice Decimal? @db.Decimal(12, 2)
  aiReply          String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotations   Quotation[]
  emailRecords EmailRecord[]
  followUps    FollowUp[]

  @@index([status])
  @@index([email])
  @@index([country])
  @@index([createdAt])
  @@index([assignedUserId])
  @@map("inquiries")
}

model Quotation {
  id            String          @id @default(cuid())
  quotationNo   String          @unique
  inquiryId     String
  inquiry       Inquiry         @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  status        QuotationStatus @default(DRAFT)
  currency      Currency        @default(USD)

  moq           String?
  leadTime      String?
  paymentTerms  String?
  shippingTerms String?
  /// Days the offer stays open; validUntil is derived from it at save time.
  validityDays  Int             @default(30)
  validUntil    DateTime?
  note          String?         @db.Text

  /// Persisted rather than derived so lists can sort and filter on money
  /// without loading every line item.
  totalAmount   Decimal         @default(0) @db.Decimal(14, 2)

  sentAt        DateTime?
  acceptedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  items        QuotationItem[]
  emailRecords EmailRecord[]

  @@index([status])
  @@index([inquiryId])
  @@index([createdAt])
  @@map("quotations")
}

model QuotationItem {
  id            String    @id @default(cuid())
  quotationId   String
  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId     String?
  productName   String
  specification String?   @db.Text
  quantity      Decimal  @db.Decimal(20, 3)
  unit          String?
  unitPrice     Decimal   @db.Decimal(12, 2)
  /// quantity * unitPrice, stored so historical documents cannot change if a
  /// line is later edited.
  amount        Decimal   @db.Decimal(14, 2)
  sortOrder     Int       @default(0)

  @@index([quotationId])
  @@map("quotation_items")
}

model EmailRecord {
  id          String         @id @default(cuid())
  emailNo     String         @unique
  inquiryId   String?
  inquiry     Inquiry?       @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  quotationId String?
  quotation   Quotation?     @relation(fields: [quotationId], references: [id], onDelete: SetNull)

  direction   EmailDirection @default(OUTBOUND)
  purpose     EmailPurpose   @default(GENERAL)
  receiver    String
  subject     String
  content     String         @db.Text
  attachment  String?
  status      EmailStatus    @default(PENDING)
  error       String?
  sentAt      DateTime?
  createdAt   DateTime       @default(now())

  @@index([inquiryId])
  @@index([quotationId])
  @@index([status])
  @@index([createdAt])
  @@map("email_records")
}

model FollowUp {
  id           String         @id @default(cuid())
  inquiryId    String
  inquiry      Inquiry        @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  followUpDate DateTime
  note         String?        @db.Text
  nextAction   String?
  status       FollowUpStatus @default(PENDING)
  completedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([inquiryId])
  @@index([status, followUpDate])
  @@map("follow_ups")
}

model Banner {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  eyebrow     String?
  description String?  @db.Text
  ctaText     String?
  alignment   String   @default("left")
  image       String
  link        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  translations BannerTranslation[]

  @@map("banners")
}

model BannerTranslation {
  id          String   @id @default(cuid())
  bannerId    String
  locale      String
  eyebrow     String?
  title       String
  subtitle    String?
  description String?  @db.Text
  ctaText     String?
  link        String?

  banner Banner @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  @@unique([bannerId, locale])
  @@index([locale])
  @@map("banner_translations")
}

model Menu {
  id        String   @id @default(cuid())
  label     String
  url       String
  parentId  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Menu?  @relation("MenuParent", fields: [parentId], references: [id], onDelete: Cascade)
  children Menu[] @relation("MenuParent")

  @@map("menus")
}

model Page {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  excerpt        String?  @db.Text
  content        String   @db.Text
  coverImage     String?
  isPublished    Boolean  @default(false)
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  translations PageTranslation[]

  @@index([slug])
  @@index([isPublished])
  @@map("pages")
}

model PageTranslation {
  id             String   @id @default(cuid())
  pageId         String
  locale         String
  title          String
  excerpt        String?  @db.Text
  content        String?  @db.Text
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, locale])
  @@index([locale])
  @@map("page_translations")
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text

  @@map("site_settings")
}

model SiteFaq {
  id        String   @id @default(cuid())
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations SiteFaqTranslation[]

  @@map("site_faqs")
}

model SiteFaqTranslation {
  id        String   @id @default(cuid())
  siteFaqId String
  locale    String
  question  String   @db.Text
  answer    String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  siteFaq SiteFaq @relation(fields: [siteFaqId], references: [id], onDelete: Cascade)

  @@unique([siteFaqId, locale])
  @@index([locale])
  @@map("site_faq_translations")
}

model PageView {
  id        String   @id @default(cuid())
  url       String   // 完整页面 URL（包含 path/search/hash）
  path      String   // 页面路径（兼容保留）
  title     String?
  views     Int      @default(1)
  date      DateTime @default(now())
  country   String?
  region    String?
  userAgent String?  @db.Text
  referrer  String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([url, date])
  @@index([path, date])
  @@index([date])
  @@map("page_views")
}

model VisitorSession {
  id        String   @id @default(cuid())
  visitorId String   @unique
  ip        String?
  country   String?
  userAgent String?
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())
  pageCount Int      @default(0)

  @@index([country])
  @@index([lastSeen])
  @@map("visitor_sessions")
}

model VisitEvent {
  id        String   @id @default(cuid())
  visitorId String
  path      String
  url       String? // 完整页面 URL（包含 path/search/hash）
  title     String?
  referrer  String?
  ip        String?
  country   String?
  userAgent String?
  isBot     Boolean  @default(false) // 爬虫/监控 UA；后台默认只统计 isBot=false 的真人
  createdAt DateTime @default(now())

  @@index([visitorId, createdAt])
  @@index([path])
  @@index([url])
  @@index([country])
  @@index([isBot, createdAt])
  @@map("visit_events")
}

model LoginRecord {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  provider  String
  success   Boolean  @default(true)
  ip        String?
  country   String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@map("login_records")
}
